"use client";

import { useEffect, useMemo, useState } from "react";
import { supabase } from "@/lib/supabase";
import { CATEGORIES } from "@/lib/data";
import LocationPicker from "@/components/business/location-picker";
import type { Session } from "@supabase/supabase-js";

const TYPE_BY_CAT: Record<string, string> = {
  gastronomia: "restaurante",
  belleza: "peluqueria",
  profesionales: "profesional",
  automotor: "automotor",
};

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

type Business = {
  id: string;
  name: string;
  slug: string;
  category?: string | null;
  description?: string | null;
  address?: string | null;
  whatsapp?: string | null;
  schedule?: string | null;
  latitude?: number | null;
  longitude?: number | null;
};

const emptyForm = {
  name: "",
  category: "calzado",
  address: "",
  whatsapp: "",
  description: "",
  schedule: "",
  p1: "",
  p2: "",
  latitude: "",
  longitude: "",
};

export default function Dashboard() {
  const [uid, setUid] = useState<string | null>(null);
  const [ready, setReady] = useState(false);
  const [mine, setMine] = useState<Business[]>([]);
  const [show, setShow] = useState(false);
  const [f, setF] = useState(emptyForm);
  const [msg, setMsg] = useState("");
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    supabase()
      .auth
      .getSession()
      .then(({ data }: { data: { session: Session | null } }) => {
        if (!data.session) {
          window.location.href = "/login";
          return;
        }

        setUid(data.session.user.id);
        setReady(true);
        load(data.session.user.id);
      });
  }, []);

  async function load(id: string) {
    const { data } = await supabase()
      .from("businesses")
      .select(
        "id,name,slug,category,description,address,whatsapp,schedule,latitude,longitude"
      )
      .eq("owner_id", id)
      .order("created_at", { ascending: false });

    setMine((data as Business[]) || []);
  }

  async function crear(e: React.FormEvent) {
    e.preventDefault();
    setMsg("");

    if (!uid) return;

    setLoading(true);

    try {
      let slug = slugify(f.name);

      const { data: dup } = await supabase()
        .from("businesses")
        .select("slug")
        .eq("slug", slug);

      if (dup && dup.length) {
        slug += "-" + Math.floor(Math.random() * 90 + 10);
      }

      const { data: biz, error } = await supabase()
        .from("businesses")
        .insert({
          owner_id: uid,
          name: f.name,
          slug,
          category: f.category,
          type: TYPE_BY_CAT[f.category] || "comercio",
          description: f.description,
          address: f.address,
          whatsapp: f.whatsapp.replace(/\D/g, ""),
          schedule: f.schedule,
          latitude: f.latitude ? Number(f.latitude) : null,
          longitude: f.longitude ? Number(f.longitude) : null,
          tags: [f.category],
        })
        .select()
        .single();

      if (error) {
        setMsg("❌ " + error.message);
        return;
      }

      const items = [f.p1, f.p2]
        .filter(Boolean)
        .map((name) => ({
          business_id: biz.id,
          name,
        }));

      if (items.length) {
        await supabase().from("items").insert(items);
      }

      window.location.href = "/negocio/" + slug;
    } finally {
      setLoading(false);
    }
  }

  const averageCompletion = useMemo(() => {
    if (!mine.length) return 0;

    const scores = mine.map((b) => {
      const checks = [
        Boolean(b.name),
        Boolean(b.category),
        Boolean(b.description),
        Boolean(b.address),
        Boolean(b.whatsapp),
        Boolean(b.schedule),
        Boolean(b.latitude && b.longitude),
      ];

      return Math.round(
        (checks.filter(Boolean).length / checks.length) * 100
      );
    });

    return Math.round(
      scores.reduce((sum, value) => sum + value, 0) / scores.length
    );
  }, [mine]);

  if (!ready) {
    return (
      <main className="sld-dashboard-loading">
        <div className="sld-dashboard-loader" />
        <p>Cargando tu centro de control…</p>
      </main>
    );
  }

  return (
    <main className="sld-dashboard">
      <div className="sld-dashboard-bg sld-dashboard-bg-one" />
      <div className="sld-dashboard-bg sld-dashboard-bg-two" />

      <div className="sld-dashboard-shell">

        <header className="sld-dashboard-topbar">
          <div>
            <div className="sld-dashboard-eyebrow">
              SAN LORENZO DIGITAL
            </div>

            <h1>
              Centro de control
            </h1>

            <p>
              Gestioná tu presencia digital en San Lorenzo desde un solo lugar.
            </p>
          </div>

          <div className="sld-dashboard-top-actions">
            <a href="/" className="sld-dashboard-ghost">
              ← Volver al inicio
            </a>

            <a href="/mapa" className="sld-dashboard-map-button">
              📍 Explorar mapa
            </a>
          </div>
        </header>

        <section className="sld-dashboard-welcome">
          <div className="sld-dashboard-welcome-copy">
            <span className="sld-dashboard-pill">
              ✦ TU NEGOCIO, MÁS VISIBLE
            </span>

            <h2>
              Tu negocio puede ser mucho más que una ficha.
            </h2>

            <p>
              Completá tu presencia, aparecé en el mapa, mostrale al barrio
              qué vendés y preparate para recibir más visitas.
            </p>

            <div className="sld-dashboard-welcome-actions">
              <button
                onClick={() => setShow(true)}
                className="sld-dashboard-primary"
              >
                + Agregar negocio
              </button>

              <a href="/para-negocios" className="sld-dashboard-secondary">
                Ver beneficios →
              </a>
            </div>
          </div>

          <div className="sld-dashboard-orbit">
            <div className="sld-orbit-ring ring-one" />
            <div className="sld-orbit-ring ring-two" />
            <div className="sld-orbit-core">
              <strong>{mine.length}</strong>
              <span>negocio{mine.length === 1 ? "" : "s"}</span>
            </div>

            <span className="sld-orbit-icon orbit-a">📍</span>
            <span className="sld-orbit-icon orbit-b">★</span>
            <span className="sld-orbit-icon orbit-c">↗</span>
          </div>
        </section>

        <section className="sld-dashboard-stats">
          <article className="sld-dash-stat">
            <div className="sld-stat-icon">🏪</div>
            <div>
              <span>Mis negocios</span>
              <strong>{mine.length}</strong>
            </div>
            <small>
              publicados
            </small>
          </article>

          <article className="sld-dash-stat">
            <div className="sld-stat-icon">✓</div>
            <div>
              <span>Perfil promedio</span>
              <strong>{averageCompletion}%</strong>
            </div>
            <small>
              completitud
            </small>
          </article>

          <article className="sld-dash-stat">
            <div className="sld-stat-icon">📍</div>
            <div>
              <span>Mapa</span>
              <strong>
                {mine.filter((b) => b.latitude && b.longitude).length}
              </strong>
            </div>
            <small>
              ubicados
            </small>
          </article>

          <article className="sld-dash-stat sld-stat-muted">
            <div className="sld-stat-icon">👁</div>
            <div>
              <span>Visitas</span>
              <strong>Próximo</strong>
            </div>
            <small>
              estadísticas
            </small>
          </article>
        </section>

        <div className="sld-dashboard-grid">

          <section className="sld-dashboard-main">

            <div className="sld-dashboard-section-title">
              <div>
                <span>GESTIÓN</span>
                <h2>Mis negocios</h2>
              </div>

              {mine.length > 0 && (
                <button
                  onClick={() => setShow(!show)}
                  className="sld-small-add"
                >
                  + Nuevo
                </button>
              )}
            </div>

            {mine.length === 0 ? (
              <div className="sld-empty-business">
                <div className="sld-empty-icon">🏪</div>

                <h3>Tu negocio todavía no está acá</h3>

                <p>
                  Creá tu primera ficha y empezá a construir tu presencia
                  digital local.
                </p>

                <button
                  onClick={() => setShow(true)}
                  className="sld-dashboard-primary"
                >
                  Crear mi negocio
                </button>
              </div>
            ) : (
              <div className="sld-business-list">
                {mine.map((b) => {
                  const completion = [
                    Boolean(b.name),
                    Boolean(b.category),
                    Boolean(b.description),
                    Boolean(b.address),
                    Boolean(b.whatsapp),
                    Boolean(b.schedule),
                    Boolean(b.latitude && b.longitude),
                  ].filter(Boolean).length;

                  const percent = Math.round((completion / 7) * 100);

                  return (
                    <article key={b.id} className="sld-dashboard-business">
                      <div className="sld-business-avatar">
                        {b.name.slice(0, 1).toUpperCase()}
                      </div>

                      <div className="sld-business-info">
                        <div className="sld-business-name-row">
                          <h3>{b.name}</h3>

                          <span className="sld-live-badge">
                            ● ACTIVO
                          </span>
                        </div>

                        <p>
                          {b.category || "Comercio local"}
                          {b.address ? ` · ${b.address}` : ""}
                        </p>

                        <div className="sld-business-progress">
                          <div className="sld-progress-label">
                            <span>Perfil completo</span>
                            <strong>{percent}%</strong>
                          </div>

                          <div className="sld-progress-track">
                            <div
                              style={{ width: `${percent}%` }}
                              className="sld-progress-fill"
                            />
                          </div>
                        </div>
                      </div>

                      <div className="sld-business-actions">
                        <a
                          href={`/negocio/${b.slug}`}
                          className="sld-view-business"
                        >
                          Ver ficha
                        </a>

                        <a
                          href={`/dashboard/editar/${b.slug}`}
                          className="sld-edit-business"
                        >
                          Editar
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>
            )}

            {show && (
              <form
                onSubmit={crear}
                className="sld-create-business"
              >
                <div className="sld-create-header">
                  <div>
                    <span>CREAR PRESENCIA</span>
                    <h2>Agregá un nuevo negocio</h2>
                    <p>
                      Cuanto más completo esté, mejor va a funcionar tu ficha.
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => setShow(false)}
                    className="sld-close-create"
                  >
                    ×
                  </button>
                </div>

                <div className="sld-form-section">
                  <div className="sld-form-section-title">
                    <span>01</span>
                    <div>
                      <strong>Información básica</strong>
                      <small>Cómo te va a encontrar la gente</small>
                    </div>
                  </div>

                  <div className="sld-form-grid">
                    <label>
                      <span>Nombre del negocio *</span>
                      <input
                        required
                        value={f.name}
                        onChange={(e) =>
                          setF({ ...f, name: e.target.value })
                        }
                        placeholder="Ej: Almendra Calzados"
                      />
                    </label>

                    <label>
                      <span>Categoría</span>
                      <select
                        value={f.category}
                        onChange={(e) =>
                          setF({ ...f, category: e.target.value })
                        }
                      >
                        {CATEGORIES.map((c) => (
                          <option key={c.id} value={c.id}>
                            {c.icon} {c.name}
                          </option>
                        ))}
                      </select>
                    </label>
                  </div>

                  <label>
                    <span>Descripción</span>
                    <textarea
                      value={f.description}
                      onChange={(e) =>
                        setF({ ...f, description: e.target.value })
                      }
                      placeholder="Contá brevemente qué ofrece tu negocio y por qué deberían elegirte…"
                      rows={4}
                    />
                  </label>
                </div>

                <div className="sld-form-section">
                  <div className="sld-form-section-title">
                    <span>02</span>
                    <div>
                      <strong>Contacto y ubicación</strong>
                      <small>Para que puedan encontrarte fácilmente</small>
                    </div>
                  </div>

                  <div className="sld-form-grid">
                    <label>
                      <span>Dirección</span>
                      <input
                        value={f.address}
                        onChange={(e) =>
                          setF({ ...f, address: e.target.value })
                        }
                        placeholder="Calle y número, San Lorenzo"
                      />
                    </label>

                    <label>
                      <span>WhatsApp</span>
                      <input
                        value={f.whatsapp}
                        onChange={(e) =>
                          setF({ ...f, whatsapp: e.target.value })
                        }
                        placeholder="549341..."
                      />
                    </label>
                  </div>

                  <LocationPicker
                    address={f.address}
                    latitude={f.latitude}
                    longitude={f.longitude}
                    onChange={({ latitude, longitude }) =>
                      setF({ ...f, latitude, longitude })
                    }
                  />

                  <label>
                    <span>Horarios</span>
                    <input
                      value={f.schedule}
                      onChange={(e) =>
                        setF({ ...f, schedule: e.target.value })
                      }
                      placeholder="Ej: Lun a Vie 9–18 · Sáb 9–13"
                    />
                  </label>
                </div>

                <div className="sld-form-section">
                  <div className="sld-form-section-title">
                    <span>03</span>
                    <div>
                      <strong>Qué ofrecés</strong>
                      <small>Mostrá tus productos o servicios</small>
                    </div>
                  </div>

                  <div className="sld-form-grid">
                    <label>
                      <span>Producto o servicio 1</span>
                      <input
                        value={f.p1}
                        onChange={(e) =>
                          setF({ ...f, p1: e.target.value })
                        }
                        placeholder="Ej: Zapatillas urbanas"
                      />
                    </label>

                    <label>
                      <span>Producto o servicio 2</span>
                      <input
                        value={f.p2}
                        onChange={(e) =>
                          setF({ ...f, p2: e.target.value })
                        }
                        placeholder="Ej: Botas de cuero"
                      />
                    </label>
                  </div>
                </div>

                <div className="sld-create-footer">
                  <div>
                    <strong>🚀 Listo para publicar</strong>
                    <span>
                      Después vas a poder editar y mejorar tu ficha.
                    </span>
                  </div>

                  <button
                    disabled={loading}
                    className="sld-publish-button"
                  >
                    {loading
                      ? "Publicando…"
                      : "Publicar mi miniweb →"}
                  </button>
                </div>

                {msg && (
                  <p className="sld-form-error">
                    {msg}
                  </p>
                )}
              </form>
            )}
          </section>

          <aside className="sld-dashboard-side">

            <section className="sld-side-card sld-growth-card">
              <span className="sld-side-label">
                CRECIMIENTO
              </span>

              <h3>
                Hacé que tu negocio se destaque.
              </h3>

              <p>
                Completá tu ficha, agregá productos, promociones y ubicación
                para aparecer mejor dentro de San Lorenzo Digital.
              </p>

              <div className="sld-growth-list">
                <div>
                  <span>✓</span>
                  <p>
                    <strong>Ficha pública</strong>
                    <small>Tu presencia dentro del directorio</small>
                  </p>
                </div>

                <div>
                  <span>✓</span>
                  <p>
                    <strong>Mapa local</strong>
                    <small>Ubicación visible para tus clientes</small>
                  </p>
                </div>

                <div>
                  <span>✦</span>
                  <p>
                    <strong>Perfil Premium</strong>
                    <small>Más herramientas próximamente</small>
                  </p>
                </div>
              </div>

              <a
                href="/para-negocios"
                className="sld-side-cta"
              >
                Conocer Premium →
              </a>
            </section>

            <section className="sld-side-card">
              <span className="sld-side-label">
                ACCESOS RÁPIDOS
              </span>

              <div className="sld-quick-links">
                <a href="/mapa">
                  <span>📍</span>
                  <div>
                    <strong>Mapa de San Lorenzo</strong>
                    <small>Explorá negocios cercanos</small>
                  </div>
                  <b>→</b>
                </a>

                <a href="/negocios">
                  <span>🔎</span>
                  <div>
                    <strong>Directorio</strong>
                    <small>Buscá negocios locales</small>
                  </div>
                  <b>→</b>
                </a>

                <a href="/para-negocios">
                  <span>💎</span>
                  <div>
                    <strong>Para negocios</strong>
                    <small>Conocé las herramientas</small>
                  </div>
                  <b>→</b>
                </a>
              </div>
            </section>

            <section className="sld-side-card sld-next-card">
              <div className="sld-next-number">
                02
              </div>

              <div>
                <span className="sld-side-label">
                  PRÓXIMAMENTE
                </span>

                <h3>
                  Estadísticas de tu negocio
                </h3>

                <p>
                  Visitas, contactos, clics en WhatsApp, rendimiento de
                  promociones y más.
                </p>
              </div>
            </section>

          </aside>
        </div>

        <footer className="sld-dashboard-footer">
          <span>
            SAN LORENZO DIGITAL
          </span>

          <span>
            Tu ciudad. Tus negocios. Tu comunidad.
          </span>
        </footer>
      </div>
    </main>
  );
}
